# Production single-host deployment. Generate this file with:
# python3 scripts/setup-production.py --domain social.example.com --email admin@example.com
# Then configure SMTP and run: python3 scripts/check-production.py
# Never commit .env. Keep it mode 0600 and back it up encrypted off-server.
COMPOSE_PROJECT_NAME=glipz-production
GLIPZ_DOMAIN=
ACME_EMAIL=

# Generated independently. Database/Redis passwords must be 64 hex characters
# so they can safely be embedded in connection URLs without URL escaping.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
GLIPZ_FEDERATION_KEY_SEED=

# Required: real SMTP service and a verified sender. No development mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Glipz

# Local persistent media is the default. Back up the media_data volume.
# For private S3-compatible storage, use s3 and fill in the S3_* values below.
GLIPZ_STORAGE_MODE=local
# S3_ENDPOINT=https://s3.ap-northeast-1.amazonaws.com
# S3_PUBLIC_ENDPOINT=https://s3.ap-northeast-1.amazonaws.com
# S3_REGION=ap-northeast-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_USE_PATH_STYLE=false

# After verifying your first account's email, add its user UUID here.
GLIPZ_ADMIN_USER_IDS=
PATREON_ENABLED=false
# Advanced optional integrations are documented in .env.reference.example.
# Public origins and security defaults are set by docker-compose.yml.

# Change all three together only if this subnet overlaps an existing host/VPC network.
GLIPZ_PROXY_SUBNET=10.245.92.0/24
GLIPZ_PROXY_IP=10.245.92.2
GLIPZ_BACKEND_PROXY_IP=10.245.92.3
# Tag a locally built revision before upgrades, e.g. glipz:git-<commit>.
GLIPZ_IMAGE=glipz:local
